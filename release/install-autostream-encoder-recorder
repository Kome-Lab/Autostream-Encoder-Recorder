#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SERVICE_NAME="encoder-recorder"
readonly COMPONENT_NAME="encoder-recorder"
readonly AUTOSTREAM_USER_ROLLBACK_LOGIN="autostream-install-rollback"
readonly MANAGED_ROOT="/opt/autostream/encoder-recorder"
readonly RELEASES_DIR="${MANAGED_ROOT}/releases"
readonly CURRENT_LINK="${MANAGED_ROOT}/current"
readonly PUBLIC_BINARY="/usr/local/bin/autostream-encoder-recorder"
readonly PUBLIC_ALIAS="/usr/local/bin/encoder-recorder"
readonly ENV_DEST="/etc/autostream/encoder-recorder.env"
readonly UNIT_DEST="/etc/systemd/system/autostream-encoder-recorder.service"
readonly UNIT_NAME="autostream-encoder-recorder.service"
readonly STATE_DIR="/var/lib/autostream/encoder-recorder"
readonly ARCHIVE_DIR="/var/lib/autostream/archives"
readonly BACKUP_BASE="/var/backups/autostream"
readonly BACKUP_ROOT="${BACKUP_BASE}/install-migrations"
readonly BACKUP_DIR="${BACKUP_ROOT}/encoder-recorder"

die() {
  printf 'install-autostream-encoder-recorder: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root (use sudo)"
[[ $# -eq 0 ]] || die "this installer does not accept arguments"

for command in \
  awk basename chmod chown cmp cp dirname ffmpeg find flock getent grep groupadd groupdel id install jq \
  ln mktemp mv readlink rm rmdir runuser sha256sum sort stat sync systemctl tar uname uniq useradd userdel usermod wc; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
[[ ${SCRIPT_DIR} == /* && -d ${SCRIPT_DIR} ]] || die "could not resolve the installer directory"
readonly SCRIPT_DIR
ARTIFACT_ID="$(basename -- "${SCRIPT_DIR}")"
[[ -n ${ARTIFACT_ID} ]] || die "could not resolve the artifact directory name"
readonly ARTIFACT_ID
if [[ ! ${ARTIFACT_ID} =~ ^autostream-encoder-recorder_(v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)_linux_(amd64|arm64)$ ]]; then
  die "the extracted directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[4]}"

case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${SCRIPT_DIR}")"
[[ ${ARTIFACT_PARENT} == /* && -d ${ARTIFACT_PARENT} ]] || die "could not resolve the artifact parent directory"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"
[[ -f ${ARCHIVE_SOURCE} && ! -L ${ARCHIVE_SOURCE} ]] || \
  die "required release archive is missing or unsafe: ${ARCHIVE_SOURCE}"
ARCHIVE_SOURCE_SIZE="$(stat -c %s -- "${ARCHIVE_SOURCE}")"
[[ ${ARCHIVE_SOURCE_SIZE} =~ ^[1-9][0-9]*$ && ${ARCHIVE_SOURCE_SIZE} -le 268435456 ]] || \
  die "release archive size must be between 1 and 268435456 bytes"
readonly ARCHIVE_SOURCE_SIZE

cleanup_running=false
signal_transaction_active=false
deferred_termination_status=0

terminate_installer() {
  local status=$1
  trap '' HUP INT TERM
  exit "${status}"
}

handle_installer_signal() {
  local status=$1
  if [[ ${signal_transaction_active} == true ]]; then
    deferred_termination_status=${status}
    return
  fi
  terminate_installer "${status}"
}

restore_installer_signal_traps() {
  if [[ ${cleanup_running} == true ]]; then
    trap '' HUP INT TERM
  else
    trap 'handle_installer_signal 129' HUP
    trap 'handle_installer_signal 130' INT
    trap 'handle_installer_signal 143' TERM
  fi
}

begin_installer_signal_transaction() {
  [[ ${signal_transaction_active} == false ]] || \
    die "nested installer signal transaction is not allowed"
  signal_transaction_active=true
}

finish_installer_signal_transaction() {
  local pending_status
  signal_transaction_active=false
  pending_status=${deferred_termination_status}
  deferred_termination_status=0
  restore_installer_signal_traps
  if (( pending_status != 0 )); then
    terminate_installer "${pending_status}"
  fi
}

input_stage_is_owned() {
  [[ -d ${INPUT_STAGE} && ! -L ${INPUT_STAGE} &&
    $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
    $(stat -c '%d:%i' -- "${INPUT_STAGE}") == "${INPUT_STAGE_IDENTITY}" ]]
}

cleanup_early_input_stage() {
  local status=$?
  trap '' HUP INT TERM
  cleanup_running=true
  signal_transaction_active=false
  deferred_termination_status=0
  trap - EXIT
  if input_stage_is_owned; then
    rm -rf -- "${INPUT_STAGE}"
  else
    printf '%s\n' "install-autostream-encoder-recorder: refusing to remove replaced installer staging" >&2
    status=1
  fi
  exit "${status}"
}

# INPUT_STAGE is the single temporary-path journal exception: it is the
# root-only durable recovery container for every artifact kept after an
# incomplete rollback. A pending signal is delivered after its exact inode is
# captured and the early EXIT cleanup owns it.
INPUT_STAGE=""
INPUT_STAGE_IDENTITY=""
input_stage_status=0
restore_installer_signal_traps
begin_installer_signal_transaction
if INPUT_STAGE="$(mktemp -d /var/tmp/autostream-encoder-recorder-install.XXXXXXXX)"; then
  :
else
  input_stage_status=$?
fi
if [[ ${input_stage_status} -ne 0 ]]; then
  finish_installer_signal_transaction
  printf 'install-autostream-encoder-recorder: could not create the installer staging directory (mktemp status %s)\n' \
    "${input_stage_status}" >&2
  exit "${input_stage_status}"
fi
if [[ ! ( -n ${INPUT_STAGE} &&
  ${INPUT_STAGE} == /var/tmp/autostream-encoder-recorder-install.* &&
  -d ${INPUT_STAGE} && ! -L ${INPUT_STAGE} &&
  $(readlink -f -- "${INPUT_STAGE}") == "${INPUT_STAGE}" &&
  $(stat -c '%U:%G:%a' -- "${INPUT_STAGE}") == "root:root:700" ) ]]; then
  rm -rf -- "${INPUT_STAGE}"
  INPUT_STAGE=""
  finish_installer_signal_transaction
  die "could not create a safe installer staging directory"
fi
if ! INPUT_STAGE_IDENTITY="$(stat -c '%d:%i' -- "${INPUT_STAGE}")"; then
  rm -rf -- "${INPUT_STAGE}"
  INPUT_STAGE=""
  finish_installer_signal_transaction
  die "could not capture the installer staging identity"
fi
readonly INPUT_STAGE
readonly INPUT_STAGE_IDENTITY
readonly UNPACK_DIR="${INPUT_STAGE}/unpack"
trap cleanup_early_input_stage EXIT
finish_installer_signal_transaction

managed_candidate=""
managed_candidate_identity=""
current_next=""
unit_stage=""
env_stage=""
public_link_next=""
activation_started=false
installation_complete=false
previous_current_kind="absent"
previous_current_target=""
declare -A previous_public_kind=()
declare -A previous_public_target=()
declare -A previous_public_mode=()
declare -A previous_public_sha256=()
unit_previous_kind="absent"
unit_previous_mode=""
unit_previous_sha256=""
unit_previous_backup="${INPUT_STAGE}/unit.previous"
unit_replaced=false
env_created=false
env_created_identity=""
rollback_incomplete=false
state_directory_snapshot_done=false
state_directory_previous_kind="unobserved"
state_directory_previous_uid=""
state_directory_previous_gid=""
state_directory_previous_mode=""
state_directory_previous_identity=""
state_directory_mutation_started=false
state_directory_created_identity=""
archive_directory_snapshot_done=false
archive_directory_previous_kind="unobserved"
archive_directory_previous_uid=""
archive_directory_previous_gid=""
archive_directory_previous_mode=""
archive_directory_previous_identity=""
archive_directory_mutation_started=false
archive_directory_created_identity=""
created_autostream_user=false
created_autostream_user_record=""
created_autostream_user_group_record=""
autostream_user_rollback_login_ready=false
created_autostream_group=false
created_autostream_group_record=""
release_created=false
release_created_identity=""
declare -a journaled_directory_order=()
declare -A journaled_directory_recorded=()
declare -A journaled_directory_previous_kind=()
declare -A journaled_directory_previous_identity=()
declare -A journaled_directory_previous_uid=()
declare -A journaled_directory_previous_gid=()
declare -A journaled_directory_previous_mode=()
declare -A journaled_directory_created_identity=()
declare -A temporary_path_identity=()
declare -A backup_previous_kind=()
declare -A backup_previous_identity=()
declare -A backup_previous_uid=()
declare -A backup_previous_gid=()
declare -A backup_previous_mode=()
declare -A backup_previous_sha256=()
declare -A backup_created_identity=()

register_temporary_path() {
  local path=$1
  [[ -z ${temporary_path_identity["${path}"]+present} ]] || return 1
  temporary_path_identity["${path}"]="pending"
}

claim_temporary_path() {
  local path=$1
  [[ -n ${temporary_path_identity["${path}"]+present} &&
    ${temporary_path_identity["${path}"]} == "pending" &&
    ( -e ${path} || -L ${path} ) ]] || return 1
  temporary_path_identity["${path}"]="$(stat -c '%d:%i' -- "${path}")"
}

create_registered_temporary_path() {
  local output_variable=$1
  local path_kind=$2
  local template=$3
  local path=""

  # mktemp and journal claim form one signal-safe ownership transaction. A
  # termination request is delivered only after the new inode is journaled.
  begin_installer_signal_transaction
  if [[ ${path_kind} == "directory" ]]; then
    if ! path="$(mktemp -d "${template}")"; then
      finish_installer_signal_transaction
      return 1
    fi
  elif [[ ${path_kind} == "file" ]]; then
    if ! path="$(mktemp "${template}")"; then
      finish_installer_signal_transaction
      return 1
    fi
  else
    finish_installer_signal_transaction
    return 1
  fi
  if ! register_temporary_path "${path}" ||
    ! claim_temporary_path "${path}"; then
    if [[ ${path_kind} == "directory" ]]; then
      rm -rf -- "${path}"
    else
      rm -f -- "${path}"
    fi
    forget_temporary_path "${path}"
    finish_installer_signal_transaction
    return 1
  fi
  printf -v "${output_variable}" '%s' "${path}"
  finish_installer_signal_transaction
}

forget_temporary_path() {
  local path=$1
  unset 'temporary_path_identity['"${path}"']'
}

cleanup_temporary_paths() {
  local path
  local identity
  local cleanup_failed=false
  for path in "${!temporary_path_identity[@]}"; do
    identity="${temporary_path_identity["${path}"]}"
    if [[ ! -e ${path} && ! -L ${path} ]]; then
      unset 'temporary_path_identity['"${path}"']'
      continue
    fi
    if [[ ${identity} == "pending" ||
      $(stat -c '%d:%i' -- "${path}") != "${identity}" ]]; then
      cleanup_failed=true
      continue
    fi
    rm -f -- "${path}" || cleanup_failed=true
    if [[ -e ${path} || -L ${path} ]]; then
      cleanup_failed=true
    else
      unset 'temporary_path_identity['"${path}"']'
    fi
  done
  [[ ${cleanup_failed} == false ]]
}

journal_directory_before_mutation() {
  local path=$1
  local snapshot_status=0
  local snapshot_identity=""
  local snapshot_uid=""
  local snapshot_gid=""
  local snapshot_mode=""
  [[ -z ${journaled_directory_recorded["${path}"]+present} ]] || return 0
  # A pending signal is delivered only after the rollback journal is complete.
  begin_installer_signal_transaction
  if [[ -e ${path} || -L ${path} ]]; then
    if [[ ! -d ${path} || -L ${path} ]]; then
      snapshot_status=1
    elif ! snapshot_identity="$(stat -c '%d:%i' -- "${path}")" ||
      ! snapshot_uid="$(stat -c '%u' -- "${path}")" ||
      ! snapshot_gid="$(stat -c '%g' -- "${path}")" ||
      ! snapshot_mode="$(stat -c '%a' -- "${path}")"; then
      snapshot_status=1
    fi
  fi
  if [[ ${snapshot_status} -eq 0 ]]; then
    journaled_directory_recorded["${path}"]=true
    journaled_directory_order+=("${path}")
    if [[ -e ${path} || -L ${path} ]]; then
      journaled_directory_previous_kind["${path}"]="directory"
      journaled_directory_previous_identity["${path}"]="${snapshot_identity}"
      journaled_directory_previous_uid["${path}"]="${snapshot_uid}"
      journaled_directory_previous_gid["${path}"]="${snapshot_gid}"
      journaled_directory_previous_mode["${path}"]="${snapshot_mode}"
    else
      journaled_directory_previous_kind["${path}"]="absent"
    fi
  fi
  finish_installer_signal_transaction
  [[ ${snapshot_status} -eq 0 ]]
}

install_journaled_directory() {
  local path=$1
  local owner=$2
  local group=$3
  local mode=$4
  local install_status=0
  local created_identity=""

  # Directory creation/normalization and identity capture are one journaled
  # mutation. A pending signal is delivered after rollback ownership is
  # complete.
  begin_installer_signal_transaction
  if install -d -o "${owner}" -g "${group}" -m "${mode}" "${path}"; then
    :
  else
    install_status=$?
  fi
  if [[ ${journaled_directory_previous_kind["${path}"]} == "absent" ]]; then
    if [[ -d ${path} && ! -L ${path} ]] &&
      created_identity="$(stat -c '%d:%i' -- "${path}")"; then
      journaled_directory_created_identity["${path}"]="${created_identity}"
    elif [[ ${install_status} -eq 0 ]]; then
      install_status=1
    fi
  fi
  finish_installer_signal_transaction
  [[ ${install_status} -eq 0 ]]
}

rollback_journaled_directories() {
  local index
  local path
  local parent
  local rollback_failed=false
  for ((index=${#journaled_directory_order[@]} - 1; index >= 0; index--)); do
    path="${journaled_directory_order[index]}"
    case "${journaled_directory_previous_kind["${path}"]}" in
      directory)
        if [[ ! -d ${path} || -L ${path} ||
          $(stat -c '%d:%i' -- "${path}") != "${journaled_directory_previous_identity["${path}"]}" ]]; then
          rollback_failed=true
          continue
        fi
        chown "${journaled_directory_previous_uid["${path}"]}:${journaled_directory_previous_gid["${path}"]}" \
          "${path}" || rollback_failed=true
        chmod "${journaled_directory_previous_mode["${path}"]}" "${path}" || rollback_failed=true
        [[ $(stat -c '%d:%i:%u:%g:%a' -- "${path}") == \
          "${journaled_directory_previous_identity["${path}"]}:${journaled_directory_previous_uid["${path}"]}:${journaled_directory_previous_gid["${path}"]}:${journaled_directory_previous_mode["${path}"]}" ]] || \
          rollback_failed=true
        ;;
      absent)
        if [[ ! -e ${path} && ! -L ${path} ]]; then
          continue
        fi
        if [[ ! -d ${path} || -L ${path} ||
          -z ${journaled_directory_created_identity["${path}"]-} ||
          $(stat -c '%d:%i' -- "${path}") != "${journaled_directory_created_identity["${path}"]}" ||
          -n $(find "${path}" -mindepth 1 -print -quit) ]]; then
          rollback_failed=true
          continue
        fi
        rmdir -- "${path}" || rollback_failed=true
        parent="$(dirname -- "${path}")"
        sync -f "${parent}" || rollback_failed=true
        ;;
      *)
        rollback_failed=true
        ;;
    esac
  done
  [[ ${rollback_failed} == false ]]
}

rollback_created_release() {
  [[ ${release_created} == true ]] || return 0
  [[ -d ${RELEASE_DIR} && ! -L ${RELEASE_DIR} &&
    $(stat -c '%d:%i' -- "${RELEASE_DIR}") == "${release_created_identity}" &&
    $(dirname -- "${RELEASE_DIR}") == "${RELEASES_DIR}" ]] || return 1
  rm -rf -- "${RELEASE_DIR}" || return 1
  [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]] || return 1
  sync -f "${RELEASES_DIR}" || return 1
  release_created=false
  release_created_identity=""
}

local_group_database_references_are_safe() {
  local account_name

  [[ -f /etc/group && ! -L /etc/group && -r /etc/group &&
    -f /etc/gshadow && ! -L /etc/gshadow && -r /etc/gshadow ]] || return 1
  for account_name in autostream "${AUTOSTREAM_USER_ROLLBACK_LOGIN}"; do
    awk -F: -v target="${account_name}" '
      function list_contains(value, count, index, names) {
        count = split(value, names, ",")
        for (index = 1; index <= count; index++) {
          if (names[index] == target) {
            return 1
          }
        }
        return 0
      }
      FILENAME == "/etc/group" && NF >= 4 && list_contains($4) {
        unsafe = 1
      }
      FILENAME == "/etc/gshadow" && NF >= 4 &&
          (list_contains($3) || list_contains($4)) {
        unsafe = 1
      }
      END {
        exit unsafe ? 1 : 0
      }
    ' /etc/group /etc/gshadow || return 1
  done
}

calculate_local_group_database_digest() {
  local digest
  local path=$1

  case "${path}" in
    /etc/group|/etc/gshadow)
      ;;
    *)
      return 1
      ;;
  esac
  digest="$(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }')" || return 1
  [[ ${digest} =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "${digest}"
}

local_group_database_digests_match() {
  local current_group_digest
  local current_gshadow_digest
  local expected_group_digest=$1
  local expected_gshadow_digest=$2

  current_group_digest="$(calculate_local_group_database_digest /etc/group)" || return 1
  current_gshadow_digest="$(calculate_local_group_database_digest /etc/gshadow)" || return 1
  [[ ${current_group_digest} == "${expected_group_digest}" &&
    ${current_gshadow_digest} == "${expected_gshadow_digest}" ]]
}

prepare_autostream_user_rollback_login() {
  if id autostream >/dev/null 2>&1; then
    return 0
  fi
  [[ -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  autostream_user_rollback_login_ready=true
}

restore_renamed_autostream_user() {
  local protected_group_record=$1
  local renamed_user_record=$2
  local group_content_digest=$3
  local gshadow_content_digest=$4
  local restoration_failed=false

  [[ -z $(getent passwd autostream || true) ]] || return 1
  [[ "$(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" || true)" == \
    "${renamed_user_record}" ]] || return 1
  if ! usermod --login autostream "${AUTOSTREAM_USER_ROLLBACK_LOGIN}"; then
    restoration_failed=true
  fi
  [[ "$(getent passwd autostream || true)" == "${created_autostream_user_record}" ]] || return 1
  [[ -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" || true) ]] || return 1
  [[ "$(getent group autostream || true)" == "${protected_group_record}" ]] || return 1
  [[ -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" || true) ]] || return 1
  local_group_database_digests_match \
    "${group_content_digest}" "${gshadow_content_digest}" || return 1
  [[ ${restoration_failed} == false ]]
}

remove_created_autostream_user_preserving_group() {
  local delete_status=0
  local expected_group_gid
  local group_content_digest
  local gshadow_content_digest
  local rename_status=0
  local renamed_user_record
  local user_record_suffix

  [[ ${created_autostream_user} == true &&
    ${autostream_user_rollback_login_ready} == true &&
    ${created_autostream_user_record} =~ ^autostream(:[^:]*:[1-9][0-9]*:[1-9][0-9]*:[^:]*:/var/lib/autostream:/usr/sbin/nologin)$ ]] || \
    return 1
  user_record_suffix="${BASH_REMATCH[1]}"
  [[ $(getent passwd autostream 2>/dev/null || true) == \
      "${created_autostream_user_record}" &&
    -n ${created_autostream_user_group_record} &&
    $(getent group autostream 2>/dev/null || true) == \
      "${created_autostream_user_group_record}" ]] || return 1
  expected_group_gid="$(printf '%s\n' "${created_autostream_user_group_record}" |
    awk -F: 'NR == 1 && $1 == "autostream" { print $3 }')"
  [[ ${expected_group_gid} =~ ^[1-9][0-9]*$ &&
    $(printf '%s\n' "${created_autostream_user_record}" |
      awk -F: 'NR == 1 { print $4 }') == "${expected_group_gid}" &&
    -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  local_group_database_references_are_safe || return 1
  group_content_digest="$(calculate_local_group_database_digest /etc/group)" || return 1
  gshadow_content_digest="$(calculate_local_group_database_digest /etc/gshadow)" || return 1

  # Ubuntu enables USERGROUPS_ENAB, so userdel removes an empty same-name
  # primary group. Rename only the invocation-created user to a verified
  # collision-free login so userdel cannot select the autostream group.
  renamed_user_record="${AUTOSTREAM_USER_ROLLBACK_LOGIN}${user_record_suffix}"
  if usermod --login "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" autostream; then
    rename_status=0
  else
    rename_status=$?
  fi
  if [[ ${rename_status} -ne 0 ||
    -n $(getent passwd autostream 2>/dev/null || true) ||
    $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) != \
      "${renamed_user_record}" ||
    $(getent group autostream 2>/dev/null || true) != \
      "${created_autostream_user_group_record}" ||
    -n $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] ||
    ! local_group_database_digests_match \
      "${group_content_digest}" "${gshadow_content_digest}"; then
    restore_renamed_autostream_user \
      "${created_autostream_user_group_record}" "${renamed_user_record}" \
      "${group_content_digest}" "${gshadow_content_digest}" || :
    return 1
  fi

  if userdel "${AUTOSTREAM_USER_ROLLBACK_LOGIN}"; then
    delete_status=0
  else
    delete_status=$?
  fi
  if [[ ${delete_status} -ne 0 ]]; then
    restore_renamed_autostream_user \
      "${created_autostream_user_group_record}" "${renamed_user_record}" \
      "${group_content_digest}" "${gshadow_content_digest}" || :
    return 1
  fi
  [[ -z $(getent passwd autostream 2>/dev/null || true) &&
    -z $(getent passwd "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    $(getent group autostream 2>/dev/null || true) == \
      "${created_autostream_user_group_record}" &&
    -z $(getent group "${AUTOSTREAM_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  local_group_database_digests_match \
    "${group_content_digest}" "${gshadow_content_digest}" || return 1
  created_autostream_user=false
  created_autostream_user_record=""
}

rollback_created_autostream_account() {
  local rollback_failed=false
  if [[ ${created_autostream_user} == true ]]; then
    if [[ "$(getent passwd autostream || true)" != "${created_autostream_user_record}" ]]; then
      rollback_failed=true
    elif ! remove_created_autostream_user_preserving_group; then
      rollback_failed=true
    else
      created_autostream_user=false
    fi
  fi
  if [[ ${created_autostream_group} == true ]]; then
    if [[ ${created_autostream_user} == true ]]; then
      rollback_failed=true
    elif [[ "$(getent group autostream || true)" != "${created_autostream_group_record}" ]]; then
      rollback_failed=true
    elif ! groupdel autostream; then
      rollback_failed=true
    elif getent group autostream >/dev/null; then
      rollback_failed=true
    else
      created_autostream_group=false
    fi
  fi
  [[ ${rollback_failed} == false ]]
}

restore_existing_state_directory() {
  local state_parent
  local created_identity="${state_directory_created_identity}"
  [[ ${state_directory_snapshot_done} == true ]] || return 1
  state_parent="$(dirname -- "${STATE_DIR}")" || return 1
  if [[ -z ${created_identity} ]]; then
    created_identity="${journaled_directory_created_identity["${STATE_DIR}"]-}"
  fi
  case "${state_directory_previous_kind}" in
    directory)
      [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} ]] || return 1
      [[ $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_directory_previous_identity}" ]] || return 1
      chown "${state_directory_previous_uid}:${state_directory_previous_gid}" "${STATE_DIR}" || return 1
      chmod "${state_directory_previous_mode}" "${STATE_DIR}" || return 1
      [[ $(stat -c '%d:%i:%u:%g:%a' -- "${STATE_DIR}") == \
        "${state_directory_previous_identity}:${state_directory_previous_uid}:${state_directory_previous_gid}:${state_directory_previous_mode}" ]] || return 1
      sync -f "${STATE_DIR}" || return 1
      ;;
    absent)
      if [[ -e ${STATE_DIR} || -L ${STATE_DIR} ]]; then
        [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
          -n ${created_identity} &&
          $(stat -c '%d:%i' -- "${STATE_DIR}") == "${created_identity}" ]] || return 1
        [[ -z $(find "${STATE_DIR}" -mindepth 1 -print -quit) ]] || return 1
        rmdir -- "${STATE_DIR}" || return 1
      fi
      [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]] || return 1
      sync -f "${state_parent}" || return 1
      ;;
    *)
      return 1
      ;;
  esac
}

restore_existing_archive_directory() {
  local archive_parent
  local created_identity="${archive_directory_created_identity}"
  [[ ${archive_directory_snapshot_done} == true ]] || return 1
  archive_parent="$(dirname -- "${ARCHIVE_DIR}")" || return 1
  if [[ -z ${created_identity} ]]; then
    created_identity="${journaled_directory_created_identity["${ARCHIVE_DIR}"]-}"
  fi
  case "${archive_directory_previous_kind}" in
    directory)
      [[ -d ${ARCHIVE_DIR} && ! -L ${ARCHIVE_DIR} ]] || return 1
      [[ $(stat -c '%d:%i' -- "${ARCHIVE_DIR}") == "${archive_directory_previous_identity}" ]] || return 1
      chown "${archive_directory_previous_uid}:${archive_directory_previous_gid}" "${ARCHIVE_DIR}" || return 1
      chmod "${archive_directory_previous_mode}" "${ARCHIVE_DIR}" || return 1
      [[ $(stat -c '%d:%i:%u:%g:%a' -- "${ARCHIVE_DIR}") == \
        "${archive_directory_previous_identity}:${archive_directory_previous_uid}:${archive_directory_previous_gid}:${archive_directory_previous_mode}" ]] || return 1
      sync -f "${ARCHIVE_DIR}" || return 1
      ;;
    absent)
      if [[ -e ${ARCHIVE_DIR} || -L ${ARCHIVE_DIR} ]]; then
        [[ -d ${ARCHIVE_DIR} && ! -L ${ARCHIVE_DIR} &&
          -n ${created_identity} &&
          $(stat -c '%d:%i' -- "${ARCHIVE_DIR}") == "${created_identity}" ]] || return 1
        [[ -z $(find "${ARCHIVE_DIR}" -mindepth 1 -print -quit) ]] || return 1
        rmdir -- "${ARCHIVE_DIR}" || return 1
      fi
      [[ ! -e ${ARCHIVE_DIR} && ! -L ${ARCHIVE_DIR} ]] || return 1
      sync -f "${archive_parent}" || return 1
      ;;
    *)
      return 1
      ;;
  esac
}

restore_current_state() {
  local restore_next="${MANAGED_ROOT}/.current.rollback.$$"
  [[ ! -e ${restore_next} && ! -L ${restore_next} ]] || return 1
  case "${previous_current_kind}" in
    absent)
      if [[ -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
        return 1
      fi
      rm -f -- "${CURRENT_LINK}" || return 1
      [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || return 1
      ;;
    symlink)
      if [[ -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]]; then
        return 1
      fi
      register_temporary_path "${restore_next}" || return 1
      ln -s -- "${previous_current_target}" "${restore_next}" || return 1
      claim_temporary_path "${restore_next}" || return 1
      mv -Tf -- "${restore_next}" "${CURRENT_LINK}" || return 1
      forget_temporary_path "${restore_next}"
      [[ -L ${CURRENT_LINK} &&
        $(readlink -- "${CURRENT_LINK}") == "${previous_current_target}" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f "${MANAGED_ROOT}" || return 1
}

restore_legacy_backup_state() {
  local path=$1
  local backup_name
  local backup_path
  backup_name="$(basename -- "${path}")" || return 1
  backup_path="${LEGACY_BACKUP_DIR}/${backup_name}"
  case "${backup_previous_kind["${path}"]-not-applicable}" in
    not-applicable)
      return 0
      ;;
    regular)
      [[ -f ${backup_path} && ! -L ${backup_path} &&
        $(stat -c '%d:%i' -- "${backup_path}") == "${backup_previous_identity["${path}"]}" &&
        $(stat -c '%u:%g:%a' -- "${backup_path}") == \
          "${backup_previous_uid["${path}"]}:${backup_previous_gid["${path}"]}:${backup_previous_mode["${path}"]}" &&
        $(sha256sum -- "${backup_path}" | awk 'NR == 1 { print $1 }') == \
          "${backup_previous_sha256["${path}"]}" ]] || return 1
      ;;
    absent)
      if [[ -z ${backup_created_identity["${path}"]-} ]]; then
        [[ ! -e ${backup_path} && ! -L ${backup_path} ]] || return 1
        return 0
      fi
      [[ -f ${backup_path} && ! -L ${backup_path} &&
        $(stat -c '%d:%i' -- "${backup_path}") == "${backup_created_identity["${path}"]}" ]] || return 1
      rm -f -- "${backup_path}" || return 1
      [[ ! -e ${backup_path} && ! -L ${backup_path} ]] || return 1
      sync -f "${LEGACY_BACKUP_DIR}" || return 1
      backup_created_identity["${path}"]=""
      ;;
    *)
      return 1
      ;;
  esac
}

restore_public_state() {
  local path=$1
  local kind="${previous_public_kind["${path}"]}"
  local restore_next="${path}.rollback.$$"
  local backup_path
  local backup_name
  [[ ! -e ${restore_next} && ! -L ${restore_next} ]] || return 1
  if [[ -e ${path} && ! -L ${path} && ! -f ${path} ]]; then
    return 1
  fi
  case "${kind}" in
    absent)
      rm -f -- "${path}" || return 1
      [[ ! -e ${path} && ! -L ${path} ]] || return 1
      ;;
    symlink)
      register_temporary_path "${restore_next}" || return 1
      ln -s -- "${previous_public_target["${path}"]}" "${restore_next}" || return 1
      claim_temporary_path "${restore_next}" || return 1
      mv -Tf -- "${restore_next}" "${path}" || return 1
      forget_temporary_path "${restore_next}"
      [[ -L ${path} &&
        $(readlink -- "${path}") == "${previous_public_target["${path}"]}" ]] || return 1
      ;;
    regular)
      backup_name="$(basename -- "${path}")" || return 1
      [[ -n ${backup_name} && ${backup_name} != */* ]] || return 1
      backup_path="${LEGACY_BACKUP_DIR}/${backup_name}"
      if [[ -f ${path} && ! -L ${path} &&
        $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == "${previous_public_sha256["${path}"]}" ]]; then
        chmod "${previous_public_mode["${path}"]}" "${path}" || return 1
      else
        [[ -f ${backup_path} && ! -L ${backup_path} ]] || return 1
        register_temporary_path "${restore_next}" || return 1
        install -o root -g root -m "${previous_public_mode["${path}"]}" \
          "${backup_path}" "${restore_next}" || return 1
        claim_temporary_path "${restore_next}" || return 1
        [[ $(sha256sum -- "${restore_next}" | awk 'NR == 1 { print $1 }') == \
          "${previous_public_sha256["${path}"]}" ]] || return 1
        mv -Tf -- "${restore_next}" "${path}" || return 1
        forget_temporary_path "${restore_next}"
      fi
      [[ -f ${path} && ! -L ${path} &&
        $(stat -c '%U:%G:%a' -- "${path}") == "root:root:${previous_public_mode["${path}"]}" &&
        $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == \
          "${previous_public_sha256["${path}"]}" ]] || return 1
      sync -f "$(dirname -- "${path}")" || return 1
      # A backup is removed only after the public binary is proven restored.
      # On incomplete rollback it remains as a durable recovery backup.
      restore_legacy_backup_state "${path}" || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f "$(dirname -- "${path}")" || return 1
}

restore_unit_state() {
  local restore_next=""
  [[ ${unit_replaced} == true ]] || return 0
  case "${unit_previous_kind}" in
    absent)
      [[ ! -L ${UNIT_DEST} ]] || return 1
      [[ ! -e ${UNIT_DEST} || -f ${UNIT_DEST} ]] || return 1
      rm -f -- "${UNIT_DEST}" || return 1
      [[ ! -e ${UNIT_DEST} && ! -L ${UNIT_DEST} ]] || return 1
      ;;
    regular)
      [[ -f ${unit_previous_backup} && ! -L ${unit_previous_backup} ]] || return 1
      create_registered_temporary_path restore_next file \
        /etc/systemd/system/.autostream-encoder-recorder.service.rollback.XXXXXXXX || return 1
      install -o root -g root -m "${unit_previous_mode}" \
        "${unit_previous_backup}" "${restore_next}" || return 1
      [[ $(sha256sum -- "${restore_next}" | awk 'NR == 1 { print $1 }') == \
        "${unit_previous_sha256}" ]] || return 1
      mv -Tf -- "${restore_next}" "${UNIT_DEST}" || return 1
      forget_temporary_path "${restore_next}"
      [[ -f ${UNIT_DEST} && ! -L ${UNIT_DEST} &&
        $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == "root:root:${unit_previous_mode}" &&
        $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
          "${unit_previous_sha256}" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac
  sync -f /etc/systemd/system || return 1
}

rollback_activation() {
  local rollback_failed=false
  if ! restore_unit_state; then
    printf '%s\n' "install-autostream-encoder-recorder: failed to restore the previous systemd unit" >&2
    rollback_failed=true
  fi
  if [[ ${env_created} == true ]]; then
    if [[ -e ${ENV_DEST} || -L ${ENV_DEST} ]]; then
      if [[ -f ${ENV_DEST} && ! -L ${ENV_DEST} &&
        -n ${env_created_identity} &&
        $(stat -c '%d:%i' -- "${ENV_DEST}") == "${env_created_identity}" ]]; then
        rm -f -- "${ENV_DEST}" || rollback_failed=true
        if [[ -e ${ENV_DEST} || -L ${ENV_DEST} ]]; then
          rollback_failed=true
        fi
      else
        printf '%s\n' "install-autostream-encoder-recorder: refused to remove an unexpected environment path during rollback" >&2
        rollback_failed=true
      fi
    fi
    if ! sync -f "$(dirname -- "${ENV_DEST}")"; then
      rollback_failed=true
    fi
  fi
  if ! restore_public_state "${PUBLIC_BINARY}"; then
    printf '%s\n' "install-autostream-encoder-recorder: failed to restore the previous canonical public binary" >&2
    rollback_failed=true
  fi
  if ! restore_public_state "${PUBLIC_ALIAS}"; then
    printf '%s\n' "install-autostream-encoder-recorder: failed to restore the previous public alias" >&2
    rollback_failed=true
  fi
  if ! restore_current_state; then
    printf '%s\n' "install-autostream-encoder-recorder: failed to restore the previous current link" >&2
    rollback_failed=true
  fi
  if [[ ${unit_replaced} == true ]] && ! systemctl daemon-reload; then
    printf '%s\n' "install-autostream-encoder-recorder: failed to reload restored systemd state" >&2
    rollback_failed=true
  fi
  if [[ ${rollback_failed} == true ]]; then
    rollback_incomplete=true
    printf '%s\n' "install-autostream-encoder-recorder: rollback was incomplete; inspect the host before retrying" >&2
    return 1
  fi
  printf '%s\n' "install-autostream-encoder-recorder: restored the pre-install activation state" >&2
}

cleanup() {
  local status=$?
  local setup_rollback_safe=true
  local managed_cleanup_identity="${managed_candidate_identity}"
  # Rollback is non-reentrant. A second signal must not interrupt restoration
  # after the EXIT trap has been removed.
  trap '' HUP INT TERM
  cleanup_running=true
  signal_transaction_active=false
  deferred_termination_status=0
  trap - EXIT
  set +e
  if [[ ${status} -ne 0 && ${activation_started} == true && ${installation_complete} != true ]]; then
    if ! rollback_activation; then
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${state_directory_mutation_started} == true &&
    ${installation_complete} != true ]]; then
    if ! restore_existing_state_directory; then
      printf '%s\n' "install-autostream-encoder-recorder: failed to restore the previous state directory metadata" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${archive_directory_mutation_started} == true &&
    ${installation_complete} != true ]]; then
    if ! restore_existing_archive_directory; then
      printf '%s\n' "install-autostream-encoder-recorder: failed to restore the previous archive directory metadata" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ -n ${managed_candidate} && ( -e ${managed_candidate} || -L ${managed_candidate} ) ]]; then
    if [[ -z ${managed_cleanup_identity} ]]; then
      managed_cleanup_identity="${temporary_path_identity["${managed_candidate}"]-}"
    fi
    if [[ -d ${managed_candidate} && ! -L ${managed_candidate} &&
      -n ${managed_cleanup_identity} &&
      ${managed_cleanup_identity} != "pending" &&
      $(stat -c '%d:%i' -- "${managed_candidate}") == "${managed_cleanup_identity}" ]]; then
      rm -rf -- "${managed_candidate}" || {
        rollback_incomplete=true
        setup_rollback_safe=false
      }
    else
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  managed_candidate=""
  managed_candidate_identity=""
  if ! cleanup_temporary_paths; then
    printf '%s\n' "install-autostream-encoder-recorder: failed to clean an invocation-owned temporary path" >&2
    rollback_incomplete=true
    setup_rollback_safe=false
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true &&
    ${setup_rollback_safe} == true && ${release_created} == true ]]; then
    if ! rollback_created_release; then
      printf '%s\n' "install-autostream-encoder-recorder: failed to remove the invocation-created release" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true &&
    ${setup_rollback_safe} == true ]]; then
    if ! rollback_journaled_directories; then
      printf '%s\n' "install-autostream-encoder-recorder: failed to restore invocation-mutated directories" >&2
      rollback_incomplete=true
      setup_rollback_safe=false
    fi
  fi
  if [[ ${status} -ne 0 && ${installation_complete} != true &&
    ${setup_rollback_safe} == true ]]; then
    if ! rollback_created_autostream_account; then
      printf '%s\n' "install-autostream-encoder-recorder: failed to remove the invocation-created service account" >&2
      rollback_incomplete=true
    fi
  fi
  if [[ ${rollback_incomplete} == true ]]; then
    recovery_evidence_ready=true
    if ! {
      printf 'service=%s\n' "${SERVICE_NAME}"
      printf 'previous_current_kind=%s\n' "${previous_current_kind}"
      printf 'previous_current_target=%s\n' "${previous_current_target}"
      printf 'public_binary_kind=%s\n' "${previous_public_kind["${PUBLIC_BINARY}"]-unknown}"
      printf 'public_binary_target=%s\n' "${previous_public_target["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_mode=%s\n' "${previous_public_mode["${PUBLIC_BINARY}"]-}"
      printf 'public_binary_sha256=%s\n' "${previous_public_sha256["${PUBLIC_BINARY}"]-}"
      printf 'public_alias_kind=%s\n' "${previous_public_kind["${PUBLIC_ALIAS}"]-unknown}"
      printf 'public_alias_target=%s\n' "${previous_public_target["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_mode=%s\n' "${previous_public_mode["${PUBLIC_ALIAS}"]-}"
      printf 'public_alias_sha256=%s\n' "${previous_public_sha256["${PUBLIC_ALIAS}"]-}"
      printf 'unit_previous_kind=%s\n' "${unit_previous_kind}"
      printf 'unit_previous_mode=%s\n' "${unit_previous_mode}"
      printf 'unit_previous_sha256=%s\n' "${unit_previous_sha256}"
    } > "${INPUT_STAGE}/recovery-state.txt"; then
      recovery_evidence_ready=false
    fi
    chown -R root:root "${INPUT_STAGE}" || recovery_evidence_ready=false
    chmod -R go-rwx "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ -f ${unit_previous_backup} && ! -L ${unit_previous_backup} ]]; then
      sync -f "${unit_previous_backup}" || recovery_evidence_ready=false
    fi
    if [[ -f ${INPUT_STAGE}/recovery-state.txt && ! -L ${INPUT_STAGE}/recovery-state.txt ]]; then
      sync -f "${INPUT_STAGE}/recovery-state.txt" || recovery_evidence_ready=false
    else
      recovery_evidence_ready=false
    fi
    sync -f "${INPUT_STAGE}" || recovery_evidence_ready=false
    if [[ ${recovery_evidence_ready} == true ]]; then
      printf 'install-autostream-encoder-recorder: root-only recovery evidence preserved at %s\n' "${INPUT_STAGE}" >&2
    else
      printf 'install-autostream-encoder-recorder: WARNING: rollback was incomplete and recovery staging could not be fully sealed; inspect %s immediately\n' "${INPUT_STAGE}" >&2
    fi
  else
    if input_stage_is_owned; then
      rm -rf -- "${INPUT_STAGE}"
    else
      printf '%s\n' "install-autostream-encoder-recorder: refusing to remove replaced installer staging" >&2
      status=1
    fi
  fi
  exit "${status}"
}
trap cleanup EXIT
restore_installer_signal_traps
install -d -o root -g root -m 0700 "${UNPACK_DIR}"

copy_stable_source() {
  local source=$1
  local destination=$2
  local identity
  local digest
  identity="$(stat -c '%d:%i:%s:%Y:%f' -- "${source}")"
  digest="$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')"
  install -o root -g root -m 0600 "${source}" "${destination}"
  [[ -f ${source} && ! -L ${source} ]] || die "release source changed while being staged: ${source}"
  [[ $(stat -c '%d:%i:%s:%Y:%f' -- "${source}") == "${identity}" ]] || \
    die "release source identity changed while being staged: ${source}"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${digest}" ]] || \
    die "release source content changed while being staged: ${source}"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${digest}" ]] || \
    die "staged release file differs from its source: ${source}"
}

copy_stable_source "${ARCHIVE_SOURCE}" "${INPUT_STAGE}/${ARCHIVE_NAME}"

ARTIFACT_SHA256="$(
  sha256sum -- "${INPUT_STAGE}/${ARCHIVE_NAME}" | awk 'NR == 1 { print $1 }'
)"
[[ ${ARTIFACT_SHA256} =~ ^[0-9a-f]{64}$ ]] || die "could not calculate the artifact SHA-256"
readonly ARTIFACT_SHA256
readonly LEGACY_BACKUP_DIR="${BACKUP_DIR}/${VERSION}-${ARTIFACT_SHA256:0:12}"
ARTIFACT_SIZE="$(stat -c %s -- "${INPUT_STAGE}/${ARCHIVE_NAME}")"
[[ ${ARTIFACT_SIZE} == "${ARCHIVE_SOURCE_SIZE}" ]] || \
  die "staged release archive size differs from its verified source"
readonly ARTIFACT_SIZE

tar -tzf "${INPUT_STAGE}/${ARCHIVE_NAME}" > "${INPUT_STAGE}/archive.list"
[[ -s ${INPUT_STAGE}/archive.list ]] || die "release archive is empty"
while IFS= read -r entry; do
  [[ ${entry} == "${ARTIFACT_ID}" || ${entry} == "${ARTIFACT_ID}/" || ${entry} == "${ARTIFACT_ID}/"* ]] || \
    die "release archive contains a path outside ${ARTIFACT_ID}: ${entry}"
  [[ ${entry} != /* &&
    ${entry} != *\\* &&
    ${entry} != ../* &&
    ${entry} != *"/../"* &&
    ${entry} != *"/.." &&
    ${entry} != *"/./"* &&
    ${entry} != *"/." &&
    ${entry} != *"//"* ]] || \
    die "release archive contains an unsafe path: ${entry}"
done < "${INPUT_STAGE}/archive.list"
duplicate_paths="$(
  awk '{ sub(/\/$/, ""); print }' "${INPUT_STAGE}/archive.list" |
    LC_ALL=C sort |
    uniq -d
)"
[[ -z ${duplicate_paths} ]] || die "release archive contains duplicate paths"
while IFS= read -r entry; do
  case "${entry:0:1}" in
    -|d) ;;
    *) die "release archive contains a link or non-regular entry" ;;
  esac
done < <(tar -tvzf "${INPUT_STAGE}/${ARCHIVE_NAME}")

tar --no-same-owner --no-same-permissions \
  -xzf "${INPUT_STAGE}/${ARCHIVE_NAME}" \
  -C "${UNPACK_DIR}"
readonly EXTRACTED_ROOT="${UNPACK_DIR}/${ARTIFACT_ID}"
[[ -d ${EXTRACTED_ROOT} && ! -L ${EXTRACTED_ROOT} ]] || die "release archive root is missing or unsafe"
[[ -z $(find "${UNPACK_DIR}" -mindepth 1 -maxdepth 1 ! -name "${ARTIFACT_ID}" -print -quit) ]] || \
  die "release archive contains more than one top-level path"
[[ -z $(find "${EXTRACTED_ROOT}" -type l -print -quit) ]] || die "release archive must not contain symlinks"
[[ -z $(find "${EXTRACTED_ROOT}" ! -type f ! -type d -print -quit) ]] || \
  die "release archive must contain only regular files and directories"
[[ -f ${EXTRACTED_ROOT}/checksums.txt && ! -L ${EXTRACTED_ROOT}/checksums.txt ]] || \
  die "release checksums.txt is missing or unsafe"

declare -A checksum_paths=()
while IFS= read -r checksum_entry; do
  [[ ${checksum_entry} =~ ^[0-9a-f]{64}\ \ (.+)$ ]] || die "inner checksum entry has an invalid format"
  checked_path="${BASH_REMATCH[1]}"
  [[ ${checked_path} == ./* ]] || die "inner checksum entry must use a ./ relative path"
  normalized_checked_path="${checked_path#./}"
  [[ -n ${normalized_checked_path} &&
    ${normalized_checked_path} != /* &&
    ${normalized_checked_path} != ./* &&
    ${normalized_checked_path} != *\\* &&
    ${normalized_checked_path} != ../* &&
    ${normalized_checked_path} != *"/../"* &&
    ${normalized_checked_path} != *"/.." &&
    ${normalized_checked_path} != *"/./"* &&
    ${normalized_checked_path} != *"/." &&
    ${normalized_checked_path} != *"//"* &&
    ${normalized_checked_path} != "checksums.txt" ]] || die "inner checksum entry has an unsafe path"
  [[ -z ${checksum_paths["${normalized_checked_path}"]+present} ]] || \
    die "inner checksum entry is duplicated: ${checked_path}"
  checksum_paths["${normalized_checked_path}"]=present
  [[ -f ${EXTRACTED_ROOT}/${checked_path} && ! -L ${EXTRACTED_ROOT}/${checked_path} ]] || \
    die "inner checksum entry does not name a regular file: ${checked_path}"
done < "${EXTRACTED_ROOT}/checksums.txt"
while IFS= read -r extracted_path; do
  extracted_relative="${extracted_path#"${EXTRACTED_ROOT}/"}"
  [[ ${extracted_relative} == "checksums.txt" ]] && continue
  [[ -n ${checksum_paths["${extracted_relative}"]+present} ]] || \
    die "release file is not covered by checksums.txt: ${extracted_relative}"
done < <(find "${EXTRACTED_ROOT}" -type f -print)
(cd -- "${EXTRACTED_ROOT}" && sha256sum --check --strict checksums.txt)

for required in \
  "bin/autostream-encoder-recorder" \
  "bin/encoder-recorder" \
  ".env.example" \
  "artifact-manifest.json" \
  "systemd/autostream-encoder-recorder.service.example" \
  "install-autostream-encoder-recorder"; do
  [[ -f ${EXTRACTED_ROOT}/${required} && ! -L ${EXTRACTED_ROOT}/${required} ]] || \
    die "required release file is missing or unsafe: ${required}"
done

jq -e \
  --arg component "${COMPONENT_NAME}" \
  --arg version "${VERSION}" \
  --arg arch "${ARCH}" \
  --arg archive_name "${ARCHIVE_NAME}" \
  --arg archive_root "${ARTIFACT_ID}" \
  '((keys | sort) ==
     ["archive", "build_date", "commit", "compatibility", "component", "platform", "schema_version", "source_version"]) and
   (.schema_version == 1) and
   (.component == $component) and
   (.source_version == $version) and
   (.commit | type == "string" and test("^[0-9a-f]{40}$")) and
   (.build_date | type == "string" and
     test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
   (.platform | type == "object") and
