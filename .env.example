AUTOSTREAM_NODE_CONFIG=/etc/autostream-encoder-recorder/config.yml
# Optional override for local/dev builds. Release and Docker builds embed this automatically.
# SERVICE_VERSION=dev
CONTROL_PANEL_HEARTBEAT_INTERVAL_SEC=30
# Panel-generated config.yml supplies SERVICE_ID, SERVICE_NAME,
# SERVICE_PUBLIC_URL, CONTROL_PANEL_URL, CONTROL_PANEL_TOKEN, and
# stream_ingest.signing_key.
#
# Compatibility fallback for older Control Panel dispatch. Prefer the
# Node Runtime Token from AUTOSTREAM_NODE_CONFIG for new Node Agent installs.
# SERVICE_CONTROL_TOKEN_SHA256=<SHA256_OF_CONTROL_PANEL_OR_WORKER_TO_SERVICE_TOKEN>
ENCODER_WORKER_EVENTS_TOKEN_SHA256=<SHA256_OF_WORKER_TO_ENCODER_EVENTS_TOKEN>
ENCODER_DISCORD_AUDIO_TOKEN_SHA256=<SHA256_OF_DISCORD_BOT_TO_ENCODER_AUDIO_TOKEN>
AUTOSTREAM_REQUIRE_SIGNED_INGEST_TOKENS=true
# Standard operation sends signals through Control Panel with the Node Runtime Token.
# Direct Observability ingest is a compatibility fallback only:
# OBSERVABILITY_URL=https://observability.example.com
# OBSERVABILITY_TOKEN=<OBSERVABILITY_INGEST_TOKEN>
OBSERVABILITY_TIMEOUT_SEC=5
ENCODER_METRICS_INTERVAL_SEC=10
ENCODER_AUDIO_SILENCE_THRESHOLD_DB=-50
ENCODER_AUDIO_CLIPPING_THRESHOLD_DB=-1
ENCODER_PACKAGE_TIMEOUT_SEC=7200
ENCODER_ARTIFACT_REPORT_TIMEOUT_SEC=10
FFMPEG_STOP_GRACE_SEC=5
AUDIO_INGEST_TIMEOUT_SEC=5
AUDIO_INGEST_METRICS_INTERVAL_SEC=5
AUDIO_INGEST_MAX_PACKETS=150
AUDIO_INGEST_MAX_OPUS_BYTES=4096
AUDIO_INGEST_MAX_BODY_BYTES=1048576
AUTOSTREAM_INPUT_ALLOWED_HOSTS=media.example.com,*.trusted-video.example.com
AUTOSTREAM_REQUIRE_INPUT_ALLOWED_HOSTS=true
AUTOSTREAM_ALLOW_HOSTNAME_INPUTS=false
AUTOSTREAM_ALLOW_DIRECT_HLS_INPUT=false
AUTOSTREAM_BIND_ADDR=127.0.0.1:8080
AUTOSTREAM_DATA_DIR=/var/lib/autostream/encoder-recorder
AUTOSTREAM_ARCHIVE_DIR=/var/lib/autostream/archives
FFMPEG_BIN=ffmpeg

# YouTube / Google Drive are normally supplied by Control Panel runtime config.
# Keep this true in production to reject YOUTUBE_* env fallback for start/dry-run.
AUTOSTREAM_REQUIRE_CONTROL_PANEL_RUNTIME_CONFIG=true

# Production output hardening. In production, set AUTOSTREAM_ENV=production and
# publish FFmpeg to a local loopback relay so YouTube stream keys do not appear
# in the FFmpeg process command line.
AUTOSTREAM_ENV=production
AUTOSTREAM_REQUIRE_OUTPUT_RELAY=true
AUTOSTREAM_OUTPUT_RELAY_URL=rtmp://127.0.0.1/autostream/{stream_id}

# Local YouTube compatibility fallback only. Do not use these as the normal production path.
# YOUTUBE_RTMP_URL=rtmps://example.youtube.com/live2
# YOUTUBE_STREAM_KEY=<YOUTUBE_STREAM_KEY>

# Google Drive archive upload is configured per stream through Control Panel
# OAuth account, folder ID, optional shared drive ID, and runtime secret leases.
GOOGLE_DRIVE_UPLOAD_RETRY_MAX=5
GOOGLE_DRIVE_UPLOAD_RETRY_BASE_DELAY_SEC=2
TZ=Asia/Tokyo
