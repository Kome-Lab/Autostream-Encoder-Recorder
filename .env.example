# Node identity, Node Runtime Token, Control Panel URL, and stream-ingest
# signing key are written to config.yml by the Panel-generated Auto Configure
# command. Do not copy those values into this env file.
AUTOSTREAM_NODE_CONFIG=/etc/autostream-encoder-recorder/config.yml
AUTOSTREAM_ENV=production
# Root-owned locally applied service configuration revision reported to the updater.
AUTOSTREAM_CONFIG_REVISION=1
# Standard host/systemd IPv4 loopback listen address. The port is configurable
# in the unprivileged range 1024-65535. If this key is absent, the binary keeps
# its legacy 127.0.0.1:8080 fallback for upgrade compatibility.
AUTOSTREAM_BIND_ADDR=127.0.0.1:8081
AUTOSTREAM_ENCODER_RECORDER_PORT=8081
AUTOSTREAM_ENCODER_RECORDER_CONTAINER_PORT=8080
AUTOSTREAM_OUTPUT_RELAY_URL=
AUTOSTREAM_OUTPUT_RELAY_MODE=direct
# Direct YouTube Live API output is the default. Set a Relay URL and choose
# legacy_stream_key or live_api_static only for an explicitly configured Relay.
# To migrate a fixed Relay to Control Panel Live API, explicitly set
# AUTOSTREAM_OUTPUT_RELAY_MODE=live_api_static and use the matching non-secret
# relay_binding_id below. URL-free native configurations are direct compatible.
# Non-secret static-Live-API Relay identifier. It is ignored by legacy mode and
# must exactly match the Control Panel YouTube Output profile's relay_binding_id
# when AUTOSTREAM_OUTPUT_RELAY_MODE=live_api_static.
AUTOSTREAM_OUTPUT_RELAY_BINDING_ID=relay-00000000-0000-0000-0000-000000000000

# Production mode requires Control Panel runtime config and the output relay.
# Signed ingest tokens are enabled by default in every environment. These
# optional overrides use the code defaults.
# SERVICE_VERSION=dev
# AUTOSTREAM_ARCHIVE_DIR=/var/lib/autostream/archives
# FFMPEG_BIN=ffmpeg
# TZ=Asia/Tokyo
# CONTROL_PANEL_HEARTBEAT_INTERVAL_SEC=30
# OBSERVABILITY_TIMEOUT_SEC=5
# ENCODER_METRICS_INTERVAL_SEC=10
# ENCODER_AUDIO_SILENCE_THRESHOLD_DB=-50
# ENCODER_AUDIO_CLIPPING_THRESHOLD_DB=-1
# ENCODER_PACKAGE_TIMEOUT_SEC=7200
# FFMPEG_STOP_GRACE_SEC=5
# AUDIO_INGEST_TIMEOUT_SEC=5
# AUDIO_INGEST_METRICS_INTERVAL_SEC=5
# AUDIO_INGEST_MAX_PACKETS=150
# AUDIO_INGEST_MAX_OPUS_BYTES=4096
# AUDIO_INGEST_MAX_BODY_BYTES=1048576
# Workerが生成した映像を暗号化SRTで受ける場合だけ有効化します。production
# では両方が明示されるまでcapabilityを広告せず、起動要求をfail closedします。
# Bindは通常、host/Dockerで公開した固定UDP port 10080を指定します。開発時に
# 動的portが必要な場合だけport 0を指定できます。advertise hostはWorkerから到達できる
# Encoder Nodeの実ホスト名またはIPです。SRT passphraseはjobごとにControl Panelが
# 配布し、env、URL、FFmpeg argv、ログ、metadataには保存しません。
# AUTOSTREAM_WORKER_VIDEO_BIND_ADDR=0.0.0.0:10080
# AUTOSTREAM_WORKER_VIDEO_ADVERTISE_HOST=encoder.example.com
# GOOGLE_DRIVE_UPLOAD_RETRY_MAX=5
# GOOGLE_DRIVE_UPLOAD_RETRY_BASE_DELAY_SEC=2

# External hostname/HLS input is denied by default. When it is required, use
# real source hosts and enable both switches; never use the example names.
# AUTOSTREAM_INPUT_ALLOWED_HOSTS=media.example.com,*.trusted-video.example.com
# AUTOSTREAM_ALLOW_HOSTNAME_INPUTS=true
# AUTOSTREAM_ALLOW_DIRECT_HLS_INPUT=true
# AUTOSTREAM_REQUIRE_INPUT_ALLOWED_HOSTS=true

# Legacy migration only. The inbound control token is used only when
# AUTOSTREAM_NODE_CONFIG is unset. Static ingest tokens are used only when
# signed ingest is explicitly disabled. New Nodes use config.yml exclusively.
# AUTOSTREAM_REQUIRE_SIGNED_INGEST_TOKENS=false
# SERVICE_CONTROL_TOKEN_SHA256=<LEGACY_SHA256>
# ENCODER_WORKER_EVENTS_TOKEN_SHA256=<LEGACY_SHA256>
# ENCODER_DISCORD_AUDIO_TOKEN_SHA256=<LEGACY_SHA256>

# Direct Observability and YouTube env values are compatibility fallbacks only.
# Standard operation obtains them through Control Panel runtime config.
# OBSERVABILITY_URL=https://observability.example.com
# OBSERVABILITY_TOKEN=<LEGACY_OBSERVABILITY_TOKEN>
# YOUTUBE_RTMP_URL=rtmps://example.youtube.com/live2
# YOUTUBE_STREAM_KEY=<YOUTUBE_STREAM_KEY>
